DB_HOST=localhost
DB_PORT=5432
DB_USER=telemetry
DB_PASSWORD=telemetry
DB_NAME=telemetry

LISTENER_PORT=20777
API_PORT=8081
UDP_QUEUE_SIZE=256
MAX_WORKERS=4
UDP_INCOME_DEADLINE=5000

# DB writer: flushes buffered telemetry rows on whichever comes first.
# Lower interval = fresher data (needed for LIVE_WINDOW_S below) at the
# cost of more, smaller inserts.
DB_WRITE_FLUSH_INTERVAL_MS=100
DB_WRITE_BATCH_SIZE=500

# Live WebSocket stream: how often to check the DB for new rows and send a
# frame (every row since the last poll goes out as one message — raising
# this means fewer, larger network messages at the cost of live latency),
# and how long to wait with no new rows before closing the stream.
STREAM_POLL_INTERVAL_MS=500
STREAM_IDLE_TIMEOUT_S=30

# How recent a driver's last telemetry row must be to show up as
# "currently live" in the driver list.
LIVE_WINDOW_S=3
